# Include inside the existing Vue site's HTTPS server block.
# When nginx is on the host, backend is loopback 8080. For Docker nginx use the service name on a shared network.
location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
}
location = /api/v1/backups/restore {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_read_timeout 300s;
    client_max_body_size 101m;
}
location ~ ^/api/v1/platforms/(ins|google|tiktok|ping0)/appeal-records/[^/]+/images$ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_read_timeout 120s;
    client_max_body_size 51m;
}
# Do not put try_files /index.html into API locations. Keep the existing SPA location / separately.
