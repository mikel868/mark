# Copy to .env. Docker Compose reads this file; plain java/mvn does not.
DB_PASSWORD=replace-with-database-password
INITIAL_ADMIN_USERNAME=admin
INITIAL_READONLY_USERNAME=readonly
# Use single quotes to keep literal bcrypt '$' characters. Generate hashes using the command in README.
INITIAL_ADMIN_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
INITIAL_READONLY_PASSWORD_HASH='replace-with-generated-bcrypt-hash'
BACKEND_PORT=8080
# Keep true behind HTTPS; set false only for local HTTP development.
SECURE_COOKIE=true
